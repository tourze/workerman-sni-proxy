{
  "name": "tourze/workerman-sni-proxy",
  "description": "基于Workerman的SNI代理服务器，支持透明代理和流量转发",
  "license": "MIT",
  "require": {
    "monolog/monolog": "^3.1",
    "psr/log": "^3|^2|^1",
    "tourze/workerman-connection-pipe": "0.0.*",
    "workerman/workerman": "^5.1"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "symfony/framework-bundle": "^7.4"
  },
  "autoload": {
    "psr-4": {
      "Tourze\\Workerman\\SNIProxy\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tourze\\Workerman\\SNIProxy\\Tests\\": "tests"
    }
  }
}